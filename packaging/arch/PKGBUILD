# Maintainer: maintainer <email>
pkgname=prebsd
pkgver=0.1
pkgrel=1
pkgdesc="Fetch and run Research Unix V4-V7 and 32V on SIMH"
arch=('any')
url="https://github.com/moebiusV/prebsd"
license=('ISC')
depends=('python' 'curl')
optdepends=('simh: to run the images' 'filsys: mount the images' 'v7unix-toolchain: cross-compile for the booted systems')
source=("$pkgname-$pkgver.tar.gz::https://github.com/moebiusV/prebsd/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr
  make DESTDIR="$pkgdir" install
}
