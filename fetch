#!/bin/sh
# fetch - download a V4/V5/V6/V7 disk image (or tape) for prebsd.
#
#   ./fetch             list available images
#   ./fetch <name>      download + unpack the named image into images/
#   ./fetch all         download everything
#
# The manifest is images.json.  Each image lists its download URL(s) and the
# target filename - the edition-prefixed name `dist/` also uses (v7-rp06.disk,
# v6-rk0, ...).  The .ini files attach those names as `../images/<name>` (simh
# runs with cwd=ini/).  The downloaded files land in images/, which is
# git-ignored.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
DEST="$HERE/images"
cd "$HERE"

jlist() {
    python3 - <<'PY'
import json
d = json.load(open('images.json'))
for img in d['images']:
    print(f"{img['name']}\t{img['description']}")
PY
}

jnames() {
    python3 - <<'PY'
import json
d = json.load(open('images.json'))
for img in d['images']:
    print(img['name'])
PY
}

jfiles() {  # jfiles NAME -> "url<TAB>from<TAB>to<TAB>sha256" lines
    python3 - "$1" <<'PY'
import json, sys
name = sys.argv[1]
d = json.load(open('images.json'))
for img in d['images']:
    if img['name'] == name:
        for f in img.get('files', []):
            print(f"{f['url']}\t{f.get('from', '')}\t{f['to']}\t{f.get('sha256', '')}")
        break
PY
}

jini() {
    python3 - "$1" <<'PY'
import json, sys
name = sys.argv[1]
d = json.load(open('images.json'))
for img in d['images']:
    if img['name'] == name:
        print(img['ini'])
        break
PY
}

name="${1:-}"

if [ $# -eq 0 ] || [ -z "$name" ]; then
    echo "usage: $0 <name|all>"
    echo "available images:"
    jlist | awk -F'\t' '{ printf "  %-14s %s\n", $1, $2 }'
    exit 0
fi

dl() {  # dl URL FROM TO SHA256
    url="$1"; from="$2"; to="$3"; sha="$4"
    if [ -f "$DEST/$to" ]; then
        if [ -z "$sha" ] || [ "$(sha256sum "$DEST/$to" 2>/dev/null | cut -d' ' -f1)" = "$sha" ]; then
            echo "  have $to (skip)"
            return
        fi
        echo "  $to checksum differs - refetching"
        rm -f "$DEST/$to"
    fi
    base="${url##*/}"
    base="${base%%\?*}"
    # SourceForge direct-download URLs end in /download - the real filename
    # is the path segment just before it.
    if [ "$base" = "download" ]; then
        base="${url%/download}"
        base="${base##*/}"
        base="${base%%\?*}"
    fi
    echo "  fetch $base -> $to"
    tmp="$DEST/.fetch-$$"
    curl -L --retry 3 -o "$tmp" "$url"
    case "$base" in
        *.gz)
            gunzip -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.xz)
            unxz -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.bz2)
            bunzip2 -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.zip)
            unzip -o "$tmp" -d "$DEST" >/dev/null
            rm -f "$tmp"
            # the archive holds more than the disk (docs, pdf); move the disk
            [ -n "$from" ] && [ -f "$DEST/$from" ] && mv "$DEST/$from" "$DEST/$to"
            ;;
        *)
            mv "$tmp" "$DEST/$to"
            ;;
    esac
    if [ -n "$sha" ]; then
        got="$(sha256sum "$DEST/$to" 2>/dev/null | cut -d' ' -f1)"
        if [ "$got" != "$sha" ]; then
            echo "  CHECKSUM MISMATCH: $to (got $got, want $sha)" >&2
            rm -f "$DEST/$to"
            return 1
        fi
    fi
    echo "  ok $to"
}

fetch_one() {
    n="$1"
    files="$(jfiles "$n")"
    [ -n "$files" ] || { echo "unknown image: $n"; echo; echo "available:"; jlist; exit 1; }
    echo "== $n =="
    printf '%s\n' "$files" | while IFS="$(printf '\t')" read -r url from to sha; do
        [ -n "$url" ] || continue
        dl "$url" "$from" "$to" "$sha"
    done
}

if [ "$name" = "all" ]; then
    for n in $(jnames); do
        fetch_one "$n"
    done
else
    fetch_one "$name"
fi

ini="$(jini "$name")"
if [ -n "$ini" ]; then
    case "$ini" in
        */*) echo "done.  boot with: ./boot.py --ini $ini" ;;
        *)   echo "done.  boot with: ./boot.py --ini ini/$ini" ;;
    esac
else
    echo "done.  (install via the gunkies guide)"
fi
