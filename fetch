#!/bin/sh
# fetch - download a V4/V5/V6/V7/32V/TOPS-10 ... disk image (or tape) for prebsd.
#
#   ./fetch             list available images
#   ./fetch <name>      download + unpack the named image into images/
#   ./fetch all         download everything
#
# The manifest is images.json.  Each image lists its download URL(s) and the
# target filename - the edition-prefixed name `dist/` also uses (v7-rp06.disk,
# v6-rk0, ...).  The .ini files attach those names as `../images/<name>` (simh
# runs with cwd=ini/).  The downloaded files land in images/, which is
# git-ignored.
#
# images/ holds the *pristine* fetched images.  Copy one to a working directory
# before mounting read-write or editing, so the pristine copy stays clean for
# the checksum to re-verify.  A file whose checksum no longer matches is kept
# (renamed .modified / .bad) rather than deleted, so the change can be inspected.
set -eu

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
DEST="$HERE/images"
cd "$HERE"

jlist() {
    python3 - <<'PY'
import json
d = json.load(open('images.json'))
for img in d['images']:
    print(f"{img['name']}\t{img['description']}")
PY
}

jnames() {
    python3 - <<'PY'
import json
d = json.load(open('images.json'))
for img in d['images']:
    print(img['name'])
PY
}

jfiles() {  # jfiles NAME -> "url<TAB>from<TAB>to<TAB>sha256" lines
    python3 - "$1" <<'PY'
import json, sys
name = sys.argv[1]
d = json.load(open('images.json'))
for img in d['images']:
    if img['name'] == name:
        for f in img.get('files', []):
            print(f"{f['url']}\t{f.get('from') or '-'}\t{f['to']}\t{f.get('sha256') or '-'}")
        break
PY
}

jini() {
    python3 - "$1" <<'PY'
import json, sys
name = sys.argv[1]
d = json.load(open('images.json'))
for img in d['images']:
    if img['name'] == name:
        print(img['ini'])
        break
PY
}

name="${1:-}"

if [ $# -eq 0 ] || [ -z "$name" ]; then
    echo "usage: $0 <name|all>"
    echo "available images:"
    jlist | awk -F'\t' '{ printf "  %-14s %s\n", $1, $2 }'
    exit 0
fi

dl() {  # dl URL FROM TO SHA256
    url="$1"; from="$2"; to="$3"; sha="$4"
    if [ -f "$DEST/$to" ]; then
        if [ -z "$sha" ] || [ "$(sha256sum "$DEST/$to" 2>/dev/null | cut -d' ' -f1)" = "$sha" ]; then
            echo "  have $to (skip)"
            return
        fi
        echo "  $to checksum differs - keeping as $to.modified, refetching"
        mv "$DEST/$to" "$DEST/$to.modified"
    fi
    base="${url##*/}"
    base="${base%%\?*}"
    # SourceForge direct-download URLs end in /download - the real filename
    # is the path segment just before it.
    if [ "$base" = "download" ]; then
        base="${url%/download}"
        base="${base##*/}"
        base="${base%%\?*}"
    fi
    # the download as it came is kept in mirror/images/, so a source that goes away does not
    # take the image with it: that copy is used when it exists (the checksum below checks it
    # like a fresh one) and when the download fails
    mir="${PREBSD_MIRROR:-$HERE/mirror}/images"
    mkdir -p "$mir"
    tmp="$DEST/.fetch-$$"
    if [ -f "$mir/$to--$base" ]; then
        echo "  mirror $base -> $to"
        cp "$mir/$to--$base" "$tmp"
    else
        echo "  fetch $base -> $to"
        if curl -L --fail --retry 3 -o "$tmp" "$url"; then
            cp "$tmp" "$mir/$to--$base.part" && mv "$mir/$to--$base.part" "$mir/$to--$base"
        else
            rm -f "$tmp"
            echo "  the download of $url failed and the mirror has no copy" >&2
            return 1
        fi
    fi
    case "$base" in
        *.gz)
            gunzip -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.xz)
            unxz -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.bz2)
            bunzip2 -c "$tmp" > "$DEST/$to"
            rm -f "$tmp"
            ;;
        *.zip)
            unzip -o "$tmp" -d "$DEST" >/dev/null
            rm -f "$tmp"
            # the archive holds more than the disk (docs, pdf); move the disk
            # (a zip of several disks lists each as its own file, from = to: they are all out now)
            [ -n "$from" ] && [ "$from" != "$to" ] && [ -f "$DEST/$from" ] && mv "$DEST/$from" "$DEST/$to"
            ;;
        *)
            mv "$tmp" "$DEST/$to"
            ;;
    esac
    if [ -n "$sha" ]; then
        got="$(sha256sum "$DEST/$to" 2>/dev/null | cut -d' ' -f1)"
        if [ "$got" != "$sha" ]; then
            echo "  CHECKSUM MISMATCH: $to - kept as $to.bad for investigation" >&2
            mv "$DEST/$to" "$DEST/$to.bad"
            return 1
        fi
    fi
    echo "  ok $to"
}

fetch_one() {
    n="$1"
    files="$(jfiles "$n")"
    [ -n "$files" ] || { echo "unknown image: $n"; echo; echo "available:"; jlist; exit 1; }
    echo "== $n =="
    printf '%s\n' "$files" | while IFS="$(printf '\t')" read -r url from to sha; do
        [ -n "$url" ] || continue
        # an empty field would vanish (tab is white space to read): '-' stands for none
        [ "$from" != "-" ] || from=
        [ "$sha" != "-" ] || sha=
        dl "$url" "$from" "$to" "$sha"
    done
}

if [ "$name" = "all" ]; then
    for n in $(jnames); do
        fetch_one "$n"
    done
else
    fetch_one "$name"
fi

ini="$(jini "$name")"
if [ -n "$ini" ]; then
    case "$ini" in
        */*) echo "done.  boot with: ./prebsd $ini" ;;
        *)   echo "done.  boot with: ./prebsd ini/$ini" ;;
    esac
else
    echo "done.  (install via the gunkies guide)"
fi
